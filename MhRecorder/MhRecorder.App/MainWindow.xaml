<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MhRecorder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MhRecorder.App.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootLayout" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Title bar ============ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="52"
              Background="{StaticResource ChromeBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- macOS-style traffic lights, matching the design mock's window chrome -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="20,0,0,0" Spacing="8">
                <Ellipse Width="11" Height="11" Fill="#FFFF5F57" />
                <Ellipse Width="11" Height="11" Fill="#FFFEBC2E" />
                <Ellipse Width="11" Height="11" Fill="#FF28C840" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="梦幻手游记录助手"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource UiDisplayFontFamily}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />

            <!-- Right margin reserves the system caption buttons' width (3 x 46
                 DIPs) — the app draws its own title bar, and content placed under
                 those buttons is unreadable. -->
            <TextBlock x:Name="BackendBadge" Grid.Column="2"
                       Margin="0,0,152,0"
                       VerticalAlignment="Center"
                       FontSize="11.5"
                       Foreground="{StaticResource TextTertiaryBrush}" />
        </Grid>

        <!-- ============ Backend banner ============
             没有后端时这里必须一直占着位置：识别、保存、导出都不可用，这比任何
             一个页面的空状态都重要。演示数据同样挂着黄条，避免被当成真实记录。 -->
        <!-- x:Bind 在 Window 上不走 FrameworkElement，绑定转换器会编译失败；
             这里和标题栏/状态栏一样，由 code-behind 跟着 ViewModel 刷。 -->
        <InfoBar x:Name="BackendNoticeBar" Grid.Row="1"
                 AutomationProperties.AutomationId="BackendNoticeBar"
                 IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="BackendNoticeButton"
                        AutomationProperties.AutomationId="BackendNoticeRetry"
                        Click="OnBackendNoticeActionClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ============ Body: sidebar + page host ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="254" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
                <StackPanel Margin="20,14,20,0" Spacing="2">
                    <TextBlock x:Name="SidebarCaption" Text="功能导航"
                               Margin="14,0,0,8"
                               FontSize="12.5"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <Button x:Name="NavImport" Style="{StaticResource NavItemButtonStyle}"
                            AutomationProperties.AutomationId="NavImport"
                            Click="OnNavImportClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavImportText" Grid.Column="0" Text="录入识别"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavImportIcon" Grid.Column="1" Text="&#xEB9F;"
                                       FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavCharacters" Style="{StaticResource NavItemButtonStyle}"
                            AutomationProperties.AutomationId="NavCharacters"
                            Click="OnNavCharactersClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavCharactersText" Grid.Column="0" Text="角色管理"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavCharactersIcon" Grid.Column="1" Text="&#xE8B7;"
                                       FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavAssets" Style="{StaticResource NavItemButtonStyle}"
                            AutomationProperties.AutomationId="NavAssets"
                            Click="OnNavAssetsClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavAssetsText" Grid.Column="0" Text="资产统计"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavAssetsIcon" Grid.Column="1" Text="&#xE9D2;"
                                       FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavSettings" Style="{StaticResource NavItemButtonStyle}"
                            AutomationProperties.AutomationId="NavSettings"
                            Click="OnNavSettingsClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavSettingsText" Grid.Column="0" Text="设置"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavSettingsIcon" Grid.Column="1" Text="&#xE713;"
                                       FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Page host -->
            <Frame x:Name="ContentFrame" Grid.Column="1"
                   Background="{StaticResource WindowBackgroundBrush}" />
        </Grid>

        <!-- ============ Footer status bar ============ -->
        <Grid Grid.Row="3" Height="40" Background="{StaticResource ChromeBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="30,0,0,0">
                <Ellipse x:Name="FooterDot" Width="7" Height="7" Fill="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterStatusText"
                           Text="已离线运行 · 数据存于本地 JSON"
                           FontSize="12"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="FooterSnapshotText" Grid.Column="2"
                       Text="最近资产快照：今天 14:32"
                       Margin="0,0,30,0"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
