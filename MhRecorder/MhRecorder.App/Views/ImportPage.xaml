<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MhRecorder.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MhRecorder.App.Controls"
    xmlns:conv="using:MhRecorder.App.Converters"
    xmlns:vm="using:MhRecorder.Core.ViewModels"
    Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <conv:SeverityConverter x:Key="Severity" />
        <conv:RatioToWidthConverter x:Key="RatioWidth" FullWidth="56" />
        <conv:ConfidenceToBrushConverter x:Key="ConfidenceBrush" />

        <!-- 字段表一行：字段 / 可改的值 / 置信度 / 原始 OCR 文字 / 还原 -->
        <DataTemplate x:Key="FieldRowTemplate" x:DataType="vm:FieldRowViewModel">
            <Grid ColumnSpacing="10" Padding="0,3" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" MinWidth="88" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Label}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind StatusText}" FontSize="10.5"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- 值本身可改：识别错了直接在这里改，保存时用的是改后的数 -->
                <TextBox Grid.Column="1"
                         Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         FontFamily="{StaticResource UiDisplayFontFamily}"
                         VerticalAlignment="Center"
                         Padding="8,3"
                         MinHeight="30"
                         BorderThickness="1"
                         CornerRadius="6"
                         AutomationProperties.AutomationId="FieldValueBox" />

                <!-- 置信度：数值 + 一条细条，低于 85% 标黄 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="{x:Bind ConfidenceText}" FontSize="12"
                               HorizontalAlignment="Left"
                               Foreground="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}}" />
                    <Border Height="3" CornerRadius="2" Background="#FFEDEDF0" Width="56"
                            HorizontalAlignment="Left">
                        <Border Background="{x:Bind Confidence, Converter={StaticResource ConfidenceBrush}}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Width="{x:Bind ConfidenceRatio, Converter={StaticResource RatioWidth}}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{x:Bind RawText}"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextTertiaryBrush}" />

                <Button Grid.Column="4"
                        Content="&#xE7A7;"
                        FontFamily="{StaticResource IconFontFamily}"
                        FontSize="12"
                        Style="{StaticResource LinkButtonStyle}"
                        Padding="6,4"
                        ToolTipService.ToolTip="还原为识别值"
                        Command="{x:Bind RevertCommand}" />
            </Grid>
        </DataTemplate>

        <!-- 身份候选：名字 + 置信度 + 依据 + 确认/排除 -->
        <DataTemplate x:Key="CandidateTemplate" x:DataType="vm:IdentityCandidateRowViewModel">
            <Border Background="{StaticResource SubtleFillBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,8"
                    Margin="0,0,10,0"
                    MinWidth="330">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Nickname}" FontSize="14" FontWeight="SemiBold" />
                            <Border Background="{StaticResource ChipBackgroundBrush}"
                                    CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ConfidenceText}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind Detail}" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind EvidenceText}" FontSize="11.5"
                                   TextWrapping="Wrap" MaxLines="2"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Content="确认"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,5"
                                FontSize="12.5"
                                Command="{x:Bind ConfirmCommand}" />
                        <Button Content="排除"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="10,5"
                                Command="{x:Bind RejectCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="ImportRoot" Padding="26,18,26,14" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ header ============ -->
        <Grid Grid.Row="0">
            <StackPanel Spacing="4">
                <TextBlock Text="录入识别" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="拖入《梦幻西游手游》截图 · 自动识别 · 逐字段核对后入库"
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="选择文件" Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,7"
                        AutomationProperties.AutomationId="SelectFilesButton"
                        Command="{x:Bind ViewModel.SelectFilesCommand}" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                        AutomationProperties.AutomationId="CaptureButton"
                        Command="{x:Bind ViewModel.CaptureCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrandBlueBrush}" />
                        <TextBlock Text="截图识别" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                        AutomationProperties.AutomationId="PasteButton"
                        Command="{x:Bind ViewModel.PasteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="粘贴 (Ctrl+V)" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ body ============ -->
        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320" />
                <ColumnDefinition Width="1.28*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- left: capture + OCR boxes -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AllowDrop="True"
                    DragOver="OnDropZoneDragOver"
                    DragLeave="OnDropZoneDragLeave"
                    Drop="OnDropZoneDrop">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- toolbar: title + zoom + capture tabs -->
                    <Grid Grid.Row="0" Padding="14,10,10,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="原始截图" Style="{StaticResource CardTitleText}"
                                   FontSize="14" VerticalAlignment="Center" />

                        <Button Grid.Column="2" Content="适应窗口" Style="{StaticResource GhostButtonStyle}"
                                Padding="10,4" FontSize="12"
                                AutomationProperties.AutomationId="FitButton"
                                Click="OnFitClick" />
                    </Grid>

                    <!-- the viewer itself; dashed frame doubles as the drop hint -->
                    <Grid Grid.Row="1" Margin="10,0,10,0">
                        <Border BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#FFF7F8FA">
                            <controls:ZoomableImageView x:Name="Viewer" Margin="1" />
                        </Border>

                        <!-- empty state: what to do when there is no capture yet -->
                        <StackPanel x:Name="DropZoneHint" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" MaxWidth="330" Spacing="0"
                                    Visibility="{x:Bind ViewModel.ShowDropHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border BorderBrush="{StaticResource BrandBlueBrush}" BorderThickness="2"
                                        CornerRadius="14" Background="Transparent" />
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFontFamily}"
                                           FontSize="22" Foreground="{StaticResource BrandBlueBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="把截图拖到这里" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource UiDisplayFontFamily}"
                                       FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="支持「人物属性」与「背包」面板，一次可拖入多张；也可以直接粘贴剪贴板"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- result but no picture: say so instead of showing the
                             drop hint over an already-recognised capture -->
                        <Border Visibility="{x:Bind ViewModel.ShowNoImageHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Background="#F2FFFFFF"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,10"
                                MaxWidth="260"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="这次识别没有可显示的截图（演示数据，或截图读取失败）"
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Border>

                        <!-- busy pill: keeps the capture visible while OCR runs -->
                        <Border Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Background="#F5FFFFFF"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,6"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="True" Width="14" Height="14"
                                              Foreground="{StaticResource BrandBlueBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Padding="14,6,14,10" Spacing="4">

                        <!-- capture tabs: one per imported image, so a batch can be
                             flipped through without covering the picture itself -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ImageTabs, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImageTabViewModel">
                                        <Button Content="{x:Bind Label}"
                                                FontSize="11.5"
                                                Padding="9,3"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Tag="{x:Bind}"
                                                Click="OnImageTabClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Text="{x:Bind ViewModel.PreviewCaption, Mode=OneWay}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="滚轮缩放 · 按住拖动平移 · 点击方框选中对应字段 · 双击适应窗口"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- right: fields -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <!-- empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.ShowEmptyResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="32" Foreground="#FFD2D4D9" HorizontalAlignment="Center" />
                        <TextBlock Text="识别结果会显示在这里" FontSize="14"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="每个字段都可以对照原始截图逐个核对、直接修改"
                                   FontSize="12" Foreground="{StaticResource TextQuaternaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- filled -->
                    <Grid Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                          Padding="16,14,16,12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- identity header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                    Background="#FFE9EDF6" VerticalAlignment="Center">
                                <Grid>
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                                    <TextBlock x:Name="AvatarInitialText"
                                               FontFamily="{StaticResource UiDisplayFontFamily}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="#FF7A86A8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.Nickname, Mode=OneWay}"
                                               FontFamily="{StaticResource UiDisplayFontFamily}"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource LevelChipBgBrush}"
                                            CornerRadius="5" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.LevelText, Mode=OneWay}"
                                                   FontSize="11.5" Foreground="#FF5A63E8" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.IdentityLine, Mode=OneWay}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="整体置信度" FontSize="10.5" HorizontalAlignment="Right"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                                <Border Background="{StaticResource BadgeGreenBgBrush}" CornerRadius="6"
                                        Padding="8,2">
                                    <TextBlock Text="{x:Bind ViewModel.ConfidenceText, Mode=OneWay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessGreenBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- source + evidence -->
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.SourceLine, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EvidenceText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasEvidence, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AppearanceText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.HasAppearance, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>

                        <!-- column headers -->
                        <Grid Grid.Row="2" Padding="0,4" ColumnSpacing="10"
                              BorderBrush="{StaticResource MutedBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" MinWidth="88" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="字段" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="1" Text="识别结果（可修改）" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="置信度" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Grid.Column="3" Text="原始 OCR 文字" FontSize="11"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </Grid>

                        <ListView Grid.Row="3"
                                  x:Name="FieldList"
                                  ItemsSource="{x:Bind ViewModel.Fields, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedField, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource FieldRowTemplate}"
                                  SelectionMode="Single"
                                  Padding="0,4,0,4"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  AutomationProperties.AutomationId="FieldTable">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="6,1" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="保存本次识别"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="18,8"
                                    AutomationProperties.AutomationId="RecognizeSaveButton"
                                    Command="{x:Bind ViewModel.SaveCommand}" />
                            <Button Content="撤销本次录入"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8"
                                    AutomationProperties.AutomationId="UndoButton"
                                    Command="{x:Bind ViewModel.UndoCommand}" />
                            <TextBlock Text="改过的值会随本次记录一起入库"
                                       VerticalAlignment="Center" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="220"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ identity strip ============ -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3" MinWidth="150">
                    <TextBlock Text="身份关联" Style="{StaticResource CardTitleText}" FontSize="13.5" />
                    <TextBlock Text="{x:Bind ViewModel.IdentityStateText, Mode=OneWay}"
                               FontSize="11.5" TextWrapping="Wrap" MaxWidth="220"
                               Foreground="{StaticResource TextTertiaryBrush}" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <!-- 候选：需要人判断 -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled"
                                  Visibility="{x:Bind ViewModel.HasCandidates, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CandidateTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 已确定 / 需要手选 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IdentityNeedsAttention, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Bind ViewModel.IdentityStateDetail, Mode=OneWay}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   MaxWidth="460"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind ViewModel.ShowOwnerPicker, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox x:Name="OwnerCombo"
                                      MinWidth="220"
                                      PlaceholderText="选择归属角色"
                                      ItemsSource="{x:Bind ViewModel.Owners, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedOwner, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="OwnerCombo" />
                            <TextBlock Text="{x:Bind ViewModel.OwnerHint, Mode=OneWay}"
                                       FontSize="11" MaxWidth="300" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ hint bar ============ -->
        <InfoBar Grid.Row="3"
                 AutomationProperties.AutomationId="ImportHintBar"
                 IsOpen="{x:Bind ViewModel.IsHintOpen, Mode=TwoWay}"
                 IsClosable="True"
                 Severity="{x:Bind ViewModel.HintSeverity, Mode=OneWay, Converter={StaticResource Severity}}"
                 Message="{x:Bind ViewModel.HintMessage, Mode=OneWay}" />
    </Grid>
</Page>
