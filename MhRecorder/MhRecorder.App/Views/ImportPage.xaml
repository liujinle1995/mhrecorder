<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MhRecorder.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MhRecorder.App.Controls"
    xmlns:conv="using:MhRecorder.App.Converters"
    Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
    </Page.Resources>

    <Grid Padding="26,20,26,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Page header ============ -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="录入识别" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="拖入《梦幻西游手游》的角色属性或背包截图，自动识别并归档"
                       Style="{StaticResource PageSubtitleText}" />
        </StackPanel>

        <!-- ============ Two-column body ============ -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.86*" />
                <ColumnDefinition Width="1.14*" />
            </Grid.ColumnDefinitions>

            <!-- = Left: drop zone = -->
            <Border x:Name="DropZoneCard"
                    Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="12"
                    AllowDrop="True"
                    DragOver="OnDropZoneDragOver"
                    DragLeave="OnDropZoneDragLeave"
                    Drop="OnDropZoneDrop"
                    Padding="1">
                <Grid>
                    <!-- Dashed drop-zone outline (a Rectangle so we can dash the stroke) -->
                    <Rectangle x:Name="DropZoneOutline"
                               RadiusX="12" RadiusY="12"
                               Stroke="#FFD9DAE0" StrokeThickness="1.2"
                               StrokeDashArray="4 3"
                               StrokeDashCap="Round"
                               Fill="Transparent"
                               IsHitTestVisible="False" />

                    <!-- Stretch horizontally so wrapped text is bounded by the
                         card width; a centred StackPanel would otherwise be
                         measured at its intrinsic width and overflow. -->
                    <StackPanel x:Name="DropEmptyPanel"
                                VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Spacing="0" Margin="28,0" MaxWidth="420">

                        <!-- Upload glyph: rounded square + arrow + dot -->
                        <Grid Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Border BorderBrush="{StaticResource BrandBlueBrush}" BorderThickness="2.6"
                                    CornerRadius="16" Background="Transparent" />
                            <TextBlock Text="&#xE898;"
                                       FontFamily="{StaticResource IconFontFamily}"
                                       FontSize="25"
                                       Foreground="{StaticResource BrandBlueBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,3,0,0" />
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrandBlueBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,9,9,0" />
                        </Grid>

                        <TextBlock Text="拖入截图开始识别"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource UiDisplayFontFamily}"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <TextBlock Text="支持「人物属性」或「背包」截图，也可直接粘贴剪贴板"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   FontSize="13.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <Button x:Name="SelectFilesButton"
                                AutomationProperties.AutomationId="SelectFilesButton"
                                AutomationProperties.Name="或点击选择文件"
                                Content="或点击选择文件"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Padding="26,10"
                                Click="OnSelectFilesClick" />

                        <TextBlock Text="拖拽 / 选择 / 粘贴 · 自动 OCR · 完全离线"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,16,0,0"
                                   FontSize="12.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" />

                        <!-- Two ways to get a screenshot without touching the disk:
                             抓取另一个应用窗口，或者粘贴已经复制的图。
                             Both end in the same recognition pipeline. -->
                        <StackPanel Orientation="Horizontal" Spacing="10"
                                    HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button x:Name="CaptureButton"
                                    AutomationProperties.AutomationId="CaptureButton"
                                    AutomationProperties.Name="截图识别"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,9"
                                    CornerRadius="8"
                                    Click="OnCaptureClick">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="&#xE722;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="14"
                                               Foreground="{StaticResource BrandBlueBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="截图识别" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="PasteButton"
                                    AutomationProperties.AutomationId="PasteButton"
                                    AutomationProperties.Name="粘贴截图"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,9"
                                    CornerRadius="8"
                                    Click="OnPasteClick">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="&#xE77F;"
                                               FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="粘贴截图 (Ctrl+V)" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Preview of the image that was captured / pasted.
                         Replaces the empty state as soon as something is loaded:
                         a screenshot you cannot see is a screenshot you cannot
                         trust. Tapping the frame opens it at full size.
                         A StackPanel (not star-sized rows) keeps the block hugging
                         the image's own aspect instead of leaving a dead band of
                         empty canvas above and below a 16:9 frame. -->
                    <StackPanel x:Name="PreviewPanel" Visibility="Collapsed"
                                Margin="14,14,14,12" VerticalAlignment="Center" Spacing="0">

                        <Border Background="#FFF7F8FA"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Tapped="OnZoomPreviewTapped">
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   Margin="8"
                                   AutomationProperties.AutomationId="PreviewImage" />
                        </Border>

                        <StackPanel Spacing="9" Margin="0,10,0,0">
                            <TextBlock x:Name="PreviewCaptionText"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        HorizontalAlignment="Center">
                                <Button x:Name="ZoomPreviewButton"
                                        AutomationProperties.AutomationId="ZoomPreviewButton"
                                        Content="放大查看"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="OnZoomPreviewClick" />
                                <Button x:Name="RecaptureButton"
                                        AutomationProperties.AutomationId="RecaptureButton"
                                        Content="重新截图"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="OnCaptureClick" />
                                <Button x:Name="ClearPreviewButton"
                                        AutomationProperties.AutomationId="ClearPreviewButton"
                                        Content="换一张"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="OnClearPreviewClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress pill instead of a full-cover wash: the preview must
                         stay visible while OCR runs, that is the whole point of
                         showing what was captured. -->
                    <Border x:Name="ScanningOverlay"
                            Visibility="Collapsed"
                            Background="#F5FFFFFF"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14,7"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing IsActive="True" Width="16" Height="16"
                                          Foreground="{StaticResource BrandBlueBrush}" />
                            <TextBlock Text="正在识别截图…" FontSize="12.5"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- = Right: recognition result = -->
            <Border Grid.Column="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16,20,18">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyResultState"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}"
                                   FontSize="34" Foreground="#FFD2D4D9" HorizontalAlignment="Center" />
                        <TextBlock Text="识别结果会显示在这里"
                                   FontSize="14" Foreground="{StaticResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="支持人物属性 + 背包截图合并识别"
                                   FontSize="12.5" Foreground="{StaticResource TextQuaternaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Filled state -->
                    <ScrollViewer x:Name="ResultScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="ResultPanel" Spacing="0">

                            <!-- Header + confidence badge -->
                            <Grid Margin="0,2,0,14">
                                <TextBlock Text="识别结果（保存前可修正）"
                                           Style="{StaticResource CardTitleText}"
                                           FontSize="15.5"
                                           VerticalAlignment="Center" />
                                <Border x:Name="ConfidenceBadge"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="{StaticResource BadgeGreenBgBrush}"
                                        CornerRadius="7"
                                        Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="识别置信度"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SuccessGreenBrush}" />
                                        <TextBlock x:Name="ConfidenceValueText"
                                                   Text="96%"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessGreenBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Character identity row -->
                            <Border Background="#FFF7F8FA" CornerRadius="10" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="58" Height="58" CornerRadius="29"
                                            Background="#FFE9EDF6" VerticalAlignment="Center">
                                        <Grid>
                                            <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                                            <TextBlock x:Name="AvatarInitialText"
                                                       FontFamily="{StaticResource UiDisplayFontFamily}"
                                                       FontSize="22" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <TextBlock x:Name="NicknameText"
                                                       Text="海淘淘"
                                                       FontFamily="{StaticResource UiDisplayFontFamily}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{StaticResource LevelChipBgBrush}"
                                                    CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="LevelChipText" Text="Lv.89"
                                                           FontSize="12"
                                                           Foreground="#FF5A63E8" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="IdentityLineText"
                                                   Text="游戏 ID 429277013 · 人物属性 + 背包"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Source chip -->
                            <Border x:Name="SourceChip"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource ChipBackgroundBrush}"
                                    CornerRadius="7"
                                    Margin="0,10,0,0"
                                    Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="&#xEB05;" FontFamily="{StaticResource IconFontFamily}"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SourceChipText"
                                               Text="来源：人物属性 + 背包 · 2 张截图"
                                               FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- How the identity was resolved, when it took more
                                 than reading a 游戏ID off the panel — e.g. a
                                 包裹 capture linked by its 人物评分. -->
                            <TextBlock x:Name="IdentityEvidenceText"
                                       Visibility="Collapsed"
                                       FontSize="12"
                                       Margin="2,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       AutomationProperties.AutomationId="IdentityEvidenceText" />

                            <!-- 发色 / 武器 read off the character model. Shown
                                 because it is what future captures will be
                                 matched on — if it looks wrong, the link it
                                 produces will be wrong too. -->
                            <TextBlock x:Name="AppearanceText"
                                       Visibility="Collapsed"
                                       FontSize="12"
                                       Margin="2,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       AutomationProperties.AutomationId="AppearanceText" />

                            <!-- A 包裹 screenshot renders no 游戏ID and no
                                 nickname, so the recogniser cannot always tell
                                 whose bag it is. The user says so here by
                                 picking one of the characters already in the
                                 library — each row shows 昵称 + 游戏ID so two
                                 characters with the same name stay apart. -->
                            <Border x:Name="OwnerPickerPanel"
                                    Visibility="Collapsed"
                                    Margin="0,10,0,0"
                                    Padding="14,12"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Background="{StaticResource ChipBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="OwnerPickerLabel"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="这张截图没有角色身份（包裹面板不显示游戏ID）。从已入库的角色里选一个，本次记录就归到它名下" />

                                    <ComboBox x:Name="OwnerCombo"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="选择角色"
                                              AutomationProperties.AutomationId="OwnerCombo" />

                                    <TextBlock x:Name="NoOwnerHintText"
                                               Visibility="Collapsed"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               Text="库里还没有角色：先在「角色管理」里新建，或先录入一张「人物属性」截图" />

                                    <!-- What will be remembered about this
                                         character, so the next bag links by itself. -->
                                    <TextBlock x:Name="AppearanceHintText"
                                               Visibility="Collapsed"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextTertiaryBrush}"
                                               AutomationProperties.AutomationId="AppearanceHintText" />
                                </StackPanel>
                            </Border>

                            <!-- HP / MP bars panel -->
                            <Border Background="{StaticResource BarsPanelBgBrush}"
                                    CornerRadius="10"
                                    Margin="0,12,0,0"
                                    Padding="16,15">
                                <Grid RowSpacing="11">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="气血"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <controls:GradientProgressBar x:Name="HpBar" Grid.Row="0" Grid.Column="1"
                                                                 UseHpGradient="True" BarHeight="20"
                                                                 Label="7,721" Ratio="1" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="魔法"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <controls:GradientProgressBar x:Name="MpBar" Grid.Row="1" Grid.Column="1"
                                                                 UseHpGradient="False" BarHeight="20"
                                                                 Label="2,215" Ratio="1" />
                                </Grid>
                            </Border>

                            <!-- 2x3 combat stat cards -->
                            <Grid Margin="0,12,0,0" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="物伤" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="PhysicalDamageText" Text="758" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="法伤" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="MagicDamageText" Text="582" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="物防" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="PhysicalDefenseText" Text="1,714" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="法防" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="MagicDefenseText" Text="948" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="速度" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="SpeedText" Text="892" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InsetCardBorderStyle}" Padding="14,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="治疗强度" Style="{StaticResource LabelText}" />
                                        <TextBlock x:Name="HealingText" Text="408" Style="{StaticResource MetricValueText}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Gold / silver -->
                            <Grid Margin="0,12,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource GoldCardBgBrush}"
                                        BorderBrush="{StaticResource GoldCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="13,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:CoinIcon Grid.Column="0" Kind="Gold" Width="22" Height="22"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="金币" FontSize="12" Foreground="#FF9A8147" />
                                            <TextBlock x:Name="GoldValueText" Text="2,942,685"
                                                       FontFamily="{StaticResource UiDisplayFontFamily}"
                                                       FontSize="16.5" FontWeight="SemiBold"
                                                       Foreground="#FF8A6A1E" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Background="{StaticResource SilverCardBgBrush}"
                                        BorderBrush="{StaticResource SilverCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="13,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:CoinIcon Grid.Column="0" Kind="Silver" Width="22" Height="22"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="银币" FontSize="12" Foreground="#FF7C8798" />
                                            <TextBlock x:Name="SilverValueText" Text="14,297,169"
                                                       FontFamily="{StaticResource UiDisplayFontFamily}"
                                                       FontSize="16.5" FontWeight="SemiBold"
                                                       Foreground="#FF47505C" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,2">
                                <Button x:Name="RecognizeSaveButton"
                                        AutomationProperties.AutomationId="RecognizeSaveButton"
                                        Content="识别并保存"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="20,9"
                                        Click="OnSaveClick" />
                                <Button x:Name="UndoButton"
                                        AutomationProperties.AutomationId="UndoButton"
                                        Content="撤销本次录入"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="18,9"
                                        Click="OnUndoClick" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Non-blocking feedback (剪贴板里没图 / 截取失败 / 没识别到内容).
             It cannot live inside the result panel: that panel is collapsed
             whenever there is no result, so the message would be invisible —
             which is exactly how the old 粘贴截图 button looked like a no-op. -->
        <InfoBar x:Name="HintBar" Grid.Row="2"
                 AutomationProperties.AutomationId="ImportHintBar"
                 IsOpen="False" IsClosable="True"
                 Severity="Informational"
                 Message="" />
    </Grid>
</Page>
