<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MhRecorder.App.Views.Dialogs.WindowPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图识别 · 选择窗口"
    PrimaryButtonText="截取该窗口"
    CloseButtonText="取消"
    DefaultButton="None"
    RequestedTheme="Light"
    Background="{StaticResource CardBackgroundBrush}"
    CornerRadius="16"
    Padding="24,22,24,20">

    <StackPanel Spacing="10" Width="470">
        <TextBlock Text="选中窗口后点「截取该窗口」：会先把它切到前台，再抓取画面（不含标题栏）"
                   FontSize="12.5"
                   LineHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <ListView x:Name="WindowList"
                  Height="320"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged"
                  AutomationProperties.AutomationId="WindowPickerList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Padding="0,4">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
