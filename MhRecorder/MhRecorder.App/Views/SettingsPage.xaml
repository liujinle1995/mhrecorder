<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MhRecorder.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style x:Key="SettingsLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="26,20,26,20" Spacing="14">

            <!-- header -->
            <StackPanel Spacing="6" Margin="0,0,0,2">
                <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="调整识别、存储与外观偏好，所有数据都保存在本机"
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <!-- ============ 识别 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" CornerRadius="12" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="识别" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="保存前显示可修正字段" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <ToggleSwitch x:Name="EditableBeforeSaveToggle"
                                          AutomationProperties.AutomationId="EditableBeforeSaveToggle"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource DesignToggleStyle}"
                                          IsOn="True"
                                          Toggled="OnEditableToggleChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="识别完成后自动跳转到角色管理" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <ToggleSwitch x:Name="AutoNavigateToggle"
                                          AutomationProperties.AutomationId="AutoNavigateToggle"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource DesignToggleStyle}"
                                          IsOn="False"
                                          Toggled="OnAutoNavigateToggleChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 数据存储 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="数据存储" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="数据目录" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="DataDirText" Text="~/Documents/梦幻记录/data.json"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="导出全部数据为 JSON" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <Button x:Name="ExportJsonButton"
                                    AutomationProperties.AutomationId="ExportJsonButton"
                                    Content="导出"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnExportJsonClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="清空本地数据"
                                       FontSize="13.5"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />
                            <Button x:Name="ClearDataButton"
                                    AutomationProperties.AutomationId="ClearDataButton"
                                    Content="清空"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnClearDataClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="关于" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="版本" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="VersionText" Text="0.9.2（本地版）"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="识别引擎（插件）" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="EngineText" Text="OCR · PP-OCRv4 (onnx)"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Which recognition plugins are installed / in use. The
                         engine is treated as a pluggable unit so alternative
                         recognisers can be added without touching the UI. -->
                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="插件明细" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="PluginDetailText"
                                       Text="加载中…"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap" MaxWidth="420" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="识别引擎版本" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock x:Name="EngineVersionText" Text="—"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="检查更新" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <Button x:Name="CheckUpdateButton"
                                    AutomationProperties.AutomationId="CheckUpdateButton"
                                    Content="检查"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Click="OnCheckUpdateClick" />
                        </Grid>
                    </Border>

                    <!-- Release notes live in a modal. As an inline card they made
                         the settings page scroll through a wall of history that
                         nobody re-reads; the dialog is one click away instead. -->
                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="版本更新记录"
                                       Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" x:Name="ChangelogSummaryText" Text="—"
                                       Style="{StaticResource SettingsValueText}"
                                       Margin="0,0,12,0" />
                            <Button Grid.Column="3" x:Name="ViewChangelogButton"
                                    AutomationProperties.AutomationId="ViewChangelogButton"
                                    Content="查看"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="66"
                                    VerticalAlignment="Center"
                                    Click="OnViewChangelogClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Margin="2,2,0,0" Text=""
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
