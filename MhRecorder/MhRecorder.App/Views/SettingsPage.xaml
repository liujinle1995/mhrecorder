<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MhRecorder.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MhRecorder.App.Converters"
    Background="{StaticResource WindowBackgroundBrush}">

    <Page.Resources>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility" />
        <Style x:Key="SettingsRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource MutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style x:Key="SettingsLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="26,20,26,20" Spacing="14">

            <!-- header -->
            <StackPanel Spacing="6" Margin="0,0,0,2">
                <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="调整识别、存储与外观偏好，所有数据都保存在本机"
                           Style="{StaticResource PageSubtitleText}" />
            </StackPanel>

            <!-- ============ 识别 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="识别" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="保存前显示可修正字段" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource DesignToggleStyle}"
                                          AutomationProperties.AutomationId="EditableBeforeSaveToggle"
                                          IsOn="{x:Bind ViewModel.EditableBeforeSave, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="识别完成后自动跳转到角色管理" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Style="{StaticResource DesignToggleStyle}"
                                          AutomationProperties.AutomationId="AutoNavigateToggle"
                                          IsOn="{x:Bind ViewModel.AutoNavigateAfterSave, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 数据存储 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="数据存储" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="数据目录" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.DataDir, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right"
                                       MaxWidth="520"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="导出全部数据为 JSON" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <Button Content="导出"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ExportJsonButton"
                                    Command="{x:Bind ViewModel.ExportJsonCommand}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="导出角色与快照为 CSV" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <Button Content="导出"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ExportCsvButton"
                                    Command="{x:Bind ViewModel.ExportCsvCommand}" />
                        </Grid>
                    </Border>

                    <!-- 完整备份：JSON + SQLite 快照 + manifest，可以直接拿回来恢复 -->
                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <StackPanel Spacing="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="完整备份（含数据库快照）"
                                           Style="{StaticResource SettingsLabelText}" />
                                <TextBlock Text="zip 内含 data.json、数据库快照与 manifest，可用于恢复"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            </StackPanel>
                            <Button Content="备份"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="BackupButton"
                                    Command="{x:Bind ViewModel.BackupCommand}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <TextBlock Text="清空本地数据"
                                       FontSize="13.5"
                                       Foreground="{StaticResource DangerRedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />
                            <Button Content="清空"
                                    Style="{StaticResource DangerOutlineButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ClearDataButton"
                                    Command="{x:Bind ViewModel.ClearDataCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <StackPanel>
                    <Border Background="#FFFAFAFB" CornerRadius="12,12,0,0" Padding="20,11">
                        <TextBlock Text="关于" Style="{StaticResource SectionHeaderText}" />
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="版本" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="识别引擎（插件）" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.EngineText, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="插件明细" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.PluginDetailText, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap" MaxWidth="420" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="识别引擎版本" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.EngineVersionText, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58">
                        <Grid>
                            <TextBlock Text="检查更新" Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <Button Content="检查"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="CheckUpdateButton"
                                    Command="{x:Bind ViewModel.CheckUpdateCommand}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsRowBorder}" MinHeight="58" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="版本更新记录"
                                       Style="{StaticResource SettingsLabelText}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ChangelogSummary, Mode=OneWay}"
                                       Style="{StaticResource SettingsValueText}"
                                       Margin="0,0,12,0" />
                            <Button Grid.Column="3" Content="查看"
                                    Style="{StaticResource GhostButtonStyle}"
                                    MinWidth="66"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ViewChangelogButton"
                                    Click="OnViewChangelogClick" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.StatusText, Mode=OneWay, Converter={StaticResource NonEmptyToVisibility}}"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Margin="2,2,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
